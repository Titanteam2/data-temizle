# Server
PORT=3000
NODE_ENV=production
APP_URL=https://datatemizle.com
ALLOWED_ORIGINS=https://datatemizle.com,https://www.datatemizle.com

# Local development admin fallback. Production admin role must be set in Supabase app_metadata.
ADMIN_EMAIL=admin@example.com

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=uploads

# Upload retention and safety
MAX_UPLOAD_BYTES=52428800
FILE_RETENTION_DAYS=7
CRON_SECRET=replace-with-a-long-random-string

# Future integrations
# RESEND_API_KEY=
# FROM_EMAIL=Data Temizle <info@datatemizle.com>

# Iyzico subscription/payment integration
IYZICO_API_KEY=your-iyzico-api-key
IYZICO_SECRET_KEY=your-iyzico-secret-key
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_PRO_PRICE_ID=
